---
import App from '../App.tsx';
import { assetUrl } from '../asset-url.ts';
import { dictionaryManifest } from '../dictionary-manifest.ts';
import '../style.css';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#315da8" />
    <meta
      name="description"
      content="日本語の単語をローマ字でつなぎ、ランダムなパスフレーズを生成します。語数や最低bit数を指定できます。"
    />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg?v=3')} />
    <title>日本語パスフレーズジェネレーター</title>
    <link
      rel="preload"
      href={assetUrl(dictionaryManifest.url)}
      as="fetch"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <App client:load />
  </body>
</html>
