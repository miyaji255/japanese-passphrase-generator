{
  "name": "japanese-passphrase-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/build-dictionaries.mjs && node scripts/build-wordlists.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-dictionaries.mjs && node scripts/build-wordlists.mjs && vite build",
    "test": "node scripts/build-dictionaries.mjs && node scripts/build-wordlists.mjs && node --test tests/*.test.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
