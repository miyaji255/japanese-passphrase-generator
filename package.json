{
  "name": "japanese-passphrase-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/build-dictionaries.ts && node scripts/build-wordlists.ts",
    "dev": "pnpm prepare:data && astro dev --host 0.0.0.0",
    "build": "pnpm prepare:data && astro build",
    "test": "pnpm prepare:data && vp test",
    "check": "pnpm prepare:data && astro sync && vp check --deny-warnings && astro check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:build": "node scripts/check-build.ts",
    "preview": "astro preview",
    "build:ci": "pnpm check && pnpm test && pnpm build && pnpm check:build",
    "deploy": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/deploy"
  },
  "dependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/solid-js": "^7.1.2",
    "@types/node": "^24.0.0",
    "astro": "^7.4.5",
    "fflate": "^0.8.3",
    "happy-dom": "^20.0.0",
    "typescript": "^6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plugin-solid": "^2.11.15",
    "vite-plus": "1.5.0",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
